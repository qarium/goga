# ********************************************************** #
# Манифест описывает анализатор дерева документов манифестов #
# ********************************************************** #

Imports:
  - Types:
      - DocumentRoot
    From: goga/ast/nodes
  - Types:
      - ASTRuleError
    From: goga/ast/errors
  - Types:
      - ASTRule
    From: goga/ast/rules

Usages:
  conventions: https://raw.githubusercontent.com/qarium/goga-lang-conventions/refs/heads/0.0.x/python/project.md

Annotations: |
  При разработке и тестировании использовать практику `conventions`.

---

"Analyzer(tree: list[DocumentRoot])":
  location: analyzer.py
  annotations: |
    Анализирует все документы на предмет ошибок

    `tree`: дерево документов которые необходимо проанализировать
  properties:
    tree -> list[DocumentRoot]: |
      Дерево документов с которым был создан анализатор
  methods:
    "analyze(rules: list[ASTRule]) -> errors:list[ASTRuleError]": |
      Анализировать правила применяемые ко всем документам

      `errors`: список ошибок после применения правил

